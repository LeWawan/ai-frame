# Copié en .env au premier ./play. Ne jamais committer .env.
# ANTHROPIC_API_KEY=sk-ant-...   (ou : ./play llm keys set anthropic)

# Jeff (jeffhub.ai) : clé vide = mock. Clé sur https://jeffhub.ai/account.
# JEFF_API_KEY=
# Fonction appelée par bin/jeff, voir le catalogue jeffhub.
# JEFF_FUNCTION=jeff.safety.guard.attempt

# Modèles par défaut des flows (voir ./play llm models).
# LOCAL_MODEL : nom Ollama sans préfixe, tiré par ./play setup.
CLAUDE_MODEL=claude-sonnet-5.5
LOCAL_MODEL=llama3.2

# Garde logs, templates et clés llm dans le repo plutôt que dans ~/Library.
LLM_USER_PATH=.llm
